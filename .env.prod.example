# Copy to .env.prod on the VPS ONLY and fill in real values. Never commit the
# filled-in file (it's gitignored). Used by docker-compose.prod.yml.

# ---- PostgreSQL (app metadata: users, pipeline registry, prompts, audit) ----
POSTGRES_DB=sellix
POSTGRES_USER=sellix
POSTGRES_PASSWORD=

# ---- MinIO (Context Lake document storage) ----
MINIO_ROOT_USER=sellix
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=context-lake-documents

# ---- Databricks (the live data source — see ADR-005) ----
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_JOB_ID=
DATABRICKS_SQL_WAREHOUSE_ID=

# ---- Neo4j (knowledge graph) ----
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- GHCR image path (owner/repo, all lowercase — ghcr.io requires it) ----
GHCR_REPO=adityajagtap18/sales-intelligence-platform

# ---- Frontend's public origin (CORS allow-list on the API) ----
PUBLIC_ORIGIN=https://sellixai.adityajagtap.com

# ---- Host ports nginx proxies to (loopback-only; change only if they collide
# with another project already on this box) ----
SPRING_API_PORT=18080
FRONTEND_PORT=18081
