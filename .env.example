# Copy to .env and adjust as needed. Every local service reads its config from here —
# nothing here is an Azure credential; see docs/decisions/ADR-001-local-first.md.

# ---- PostgreSQL (app metadata: users, pipeline registry, prompts, audit) ----
POSTGRES_DB=nexora
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora_dev_password
POSTGRES_PORT=5434

# ---- SQL Server (local source DB — restore AdventureWorksLT2022 here, then
# extract tables and upload to Databricks; see ADR-005) ----
SQLSERVER_SA_PASSWORD=Nexora_dev_password1
SQLSERVER_PORT=1433

# ---- MinIO (local documents / Context Lake files only — NOT analytical data
# since ADR-005; Bronze/Silver/Gold now live in Databricks) ----
MINIO_ROOT_USER=nexora
MINIO_ROOT_PASSWORD=nexora_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=context-lake-documents

# ---- Databricks Free Edition (the one cloud component — see ADR-005).
# Generate the PAT in the workspace: User Settings -> Developer -> Access
# tokens. Never commit this file with real values filled in. ----
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# ---- Neo4j (knowledge graph) ----
NEO4J_USER=neo4j
NEO4J_PASSWORD=nexora_dev_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---- Qdrant (vector database) ----
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# ---- Ollama (local LLM inference) ----
OLLAMA_PORT=11434

# ---- Observability ----
OTEL_COLLECTOR_GRPC_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3010
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=nexora_dev_password

# ---- Spring Boot API ----
SPRING_API_PORT=8081
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/nexora
SPRING_DATASOURCE_USERNAME=nexora
SPRING_DATASOURCE_PASSWORD=nexora_dev_password
